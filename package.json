{
  "name": "agentplex",
  "version": "0.0.0",
  "private": true,
  "description": "Watch and drive coding-agent sessions across machines",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/softiesolutions/agentplex.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "docker:check": "docker compose -f docker-compose.test.yml run --rm --build check",
    "docker:test": "docker compose -f docker-compose.test.yml run --rm --build test",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
