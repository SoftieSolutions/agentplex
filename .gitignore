node_modules/
dist/
coverage/

# The staged publishable packages, one per app that publishes one. `pnpm
# package` rebuilds each from that app's dist/, so a checked-in copy could only
# ever be a stale one.
apps/*/release/

# The loose files a release publishes beside its tarball -- the metadata asset
# and the description the workflow reads back. Written only when the assembler
# is handed a tag, which a contributor never does.
release-assets/
*.tsbuildinfo
.env
.env.local
.DS_Store

# Agent tooling's local configuration and the worktrees it checks this
# repository out into, inside itself.
.claude/
