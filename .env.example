# Copy to .env and edit. .env is gitignored; nothing in it belongs in a commit.
#
# The database is not in here. It is a SQLite file inside a named volume, and
# docker-compose.yml points the hub at it directly; there is no host, no port
# and no password to set.

# The hostname Caddy answers on and asks a certificate for. A public name that
# resolves to this machine gets a real certificate; localhost gets one Caddy
# signs itself, which is enough to try the stack out and not enough for web
# push, which insists on a certificate the browser already trusts.
AGENTPLEX_DOMAIN=localhost

# Where the hub's own port is published on the host. Loopback is the right
# answer whenever something else terminates TLS on this machine: Caddy in the
# compose file, `tailscale serve`, or a reverse proxy. Set it to 0.0.0.0 only
# if you mean to serve plain HTTP to the network.
AGENTPLEX_HUB_BIND=127.0.0.1

# debug, info, warn, error.
AGENTPLEX_LOG_LEVEL=info
