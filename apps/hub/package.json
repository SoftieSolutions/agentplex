{
  "name": "@agentplex/hub",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --config ../../scripts/vitest.config.ts --passWithNoTests",
    "test:coverage": "vitest run --config ../../scripts/vitest.config.ts --coverage --passWithNoTests",
    "start": "node dist/main.js",
    "dev": "node --watch --experimental-strip-types src/main.ts"
  },
  "dependencies": {
    "@agentplex/node-shared": "workspace:*",
    "@agentplex/protocol": "workspace:*",
    "@agentplex/providers": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@softiesolutions/agentplex-web": "workspace:*",
    "zod": ">=4.5.4 <5.0.0"
  },
  "devDependencies": {
    "@types/node": ">=24.13.3 <25.0.0",
    "@types/ws": ">=8.18.1 <9.0.0",
    "@vitest/coverage-v8": ">=3.2.7 <4.0.0",
    "typescript": ">=5.9.3 <6.0.0",
    "vitest": ">=3.2.7 <4.0.0",
    "ws": ">=8.21.3 <9.0.0"
  }
}
