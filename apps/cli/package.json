{
  "name": "@softiesolutions/agentplex",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "agentplex": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --config ../../scripts/vitest.config.ts --passWithNoTests",
    "test:coverage": "vitest run --config ../../scripts/vitest.config.ts --coverage --passWithNoTests"
  },
  "dependencies": {
    "@agentplex/node-shared": "workspace:*",
    "@agentplex/protocol": "workspace:*",
    "@agentplex/providers": "workspace:*",
    "@agentplex/pty": "workspace:*",
    "@agentplex/release": "workspace:*",
    "zod": ">=4.5.4 <5.0.0"
  },
  "devDependencies": {
    "@types/node": ">=24.13.3 <25.0.0",
    "@vitest/coverage-v8": ">=3.2.7 <4.0.0",
    "typescript": ">=5.9.3 <6.0.0",
    "vitest": ">=3.2.7 <4.0.0"
  }
}
