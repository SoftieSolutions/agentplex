{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    // Emitting, so off again: the one module that needs it is a test's import.
    "allowImportingTsExtensions": false,
    "declaration": true,
    "declarationMap": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/fake-*.ts", "src/**/test-*.ts"]
}
