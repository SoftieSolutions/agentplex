{
  "name": "@agentplex/pty",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "scripts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --config ../../scripts/vitest.config.ts --passWithNoTests",
    "test:coverage": "vitest run --config ../../scripts/vitest.config.ts --coverage --passWithNoTests",
    "postinstall": "node scripts/node-pty-postinstall.js"
  },
  "dependencies": {
    "@agentplex/node-shared": "workspace:*",
    "@agentplex/providers": "workspace:*",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^3.2.7",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
